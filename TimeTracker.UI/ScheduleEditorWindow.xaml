<Window x:Class="TimeTracker.UI.ScheduleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:TimeTracker.UI"
        mc:Ignorable="d"
        Title="ScheduleEditorWindow" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Schedule.Title}" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox Width="150" Text="{Binding NewGroupTitle, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox Width="100" Margin="10,0,0,0" Text="{Binding NewGroupColor, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="Add Group" Command="{Binding AddGroupCommand}" Margin="10,0,0,0" />
        </StackPanel>

        <ListBox Grid.Row="2" Height="80" ItemsSource="{Binding Groups}" DisplayMemberPath="Title" Margin="0,0,0,10" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox Width="120" Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox Width="100" Margin="5,0,0,0"
                      ItemsSource="{Binding Groups}"
                      DisplayMemberPath="Title"
                      SelectedItem="{Binding SelectedGroup}" />
            <TextBox Width="40" Margin="5,0,0,0" Text="{Binding NewOrder, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox Width="60" Margin="5,0,0,0" Text="{Binding NewStartTime, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox Width="60" Margin="5,0,0,0" Text="{Binding NewEndTime, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="Add Task" Command="{Binding AddTaskToScheduleCommand}" Margin="5,0,0,0" />
        </StackPanel>

        <ListBox Grid.Row="4" ItemsSource="{Binding TasksInSchedules}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Task.Title}" Width="150" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StartTime}" Width="80" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding EndTime}" Width="80" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Order}" Width="40" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>